<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <QuickPersistrPackageVersion>0.0.0-smoke</QuickPersistrPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="QuickPersistr.EntityFrameworkCore.Sqlite" Version="$(QuickPersistrPackageVersion)" />
    <PackageReference Include="QuickPersistr.EntityFrameworkCore.PostgreSql" Version="$(QuickPersistrPackageVersion)" />
  </ItemGroup>

</Project>
